{
  "name": "humana-finance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:demo": "tsx prisma/seed-demo.ts",
    "db:reset": "tsx prisma/reset.ts && tsx prisma/seed.ts",
    "db:migrate-from-sqlite": "tsx prisma/migrate-sqlite-to-postgres.ts",
    "db:use-sqlite": "tsx prisma/set-provider.ts sqlite",
    "db:use-postgres": "tsx prisma/set-provider.ts postgresql",
    "verify:requests": "tsx prisma/verify-requests.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-libsql": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "exceljs": "^4.4.0",
    "next": "16.2.12",
    "papaparse": "^5.5.4",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "xlsx": "^0.18.5"
  }
}
