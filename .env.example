# Copy to .env for local work; set the same keys in the Vercel project settings
# for production. Never commit the filled-in .env — it is gitignored.

# Neon Postgres, pooled connection string (the one ending -pooler).
# Use a Neon *dev branch* locally and the main branch in production, so local
# experiments can never touch live figures.
DATABASE_URL=

# Signs the session cookie. Generate a fresh one for production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Shared key the 1C push endpoint (/api/import/1c) checks.
ONEC_API_KEY=

# Public base URL, used to build data-request fill links. Must be the real
# deployed domain in production — a localhost link is useless to a recipient.
APP_URL=http://localhost:3005

# Optional automatic delivery of data-request links. Left empty, requests still
# work and the app gives you a copyable link to send yourself.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# AI analyst chat. Empty = feature off with a setup hint in the UI.
ANTHROPIC_API_KEY=

# Email delivery of data-request links (Gmail: create an app password under
# Google Account → Security → 2-Step Verification → App passwords).
# Empty = email delivery off; Telegram/copyable link still work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender shown to recipients; defaults to "Humana Finance <SMTP_USER>".
MAIL_FROM=
# Where "data submitted" notifications go; defaults to SMTP_USER.
NOTIFY_EMAIL=

# Bearer secret Vercel Cron sends to /api/cron/requests (monthly auto-send).
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=
