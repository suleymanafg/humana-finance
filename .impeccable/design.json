      "html": "<nav class=\"ds-nav\"><a class=\"is-on\" href=\"#\">Обзор</a><a href=\"#\">Прибыль</a><a href=\"#\">Товары</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:1px;width:240px;padding:8px 0;background:var(--sidebar,#1e1b4b)}.ds-nav a{display:block;padding:8px 20px;border-left:2px solid transparent;color:var(--sidebar-fg,#adaae3);font:13.5px Inter,sans-serif;text-decoration:none;transition:background-color .15s,color .15s}.ds-nav a:hover{background:rgba(255,255,255,.04);color:#fff}.ds-nav a.is-on{border-left-color:var(--sidebar-accent,#a9a7ff);background:rgba(255,255,255,.07);color:#fff;font-weight:500}.ds-nav a:focus-visible{outline:2px solid var(--sidebar-accent,#a9a7ff);outline-offset:-2px}"
    },
    {
      "name": "Pulse Tile",
      "kind": "custom",
      "refersTo": "pulse-tile-active",
      "description": "Overview figure that switches the focus chart; active = indigo wash + inset outline.",
      "html": "<div class=\"ds-pulse\"><button class=\"ds-tile is-on\"><span class=\"l\">Продажи с НДС</span><span class=\"v\">1.2 млрд</span><span class=\"c\"><b>+4%</b> к августу</span></button><button class=\"ds-tile\"><span class=\"l\">Запас</span><span class=\"v w\">3.1 мес</span><span class=\"c w\">ниже нормы 4 мес</span></button></div>",
      "css": ".ds-pulse{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--border,#e2e8f0);border:1px solid var(--border,#e2e8f0);border-radius:8px;overflow:hidden}.ds-tile{display:flex;flex-direction:column;align-items:flex-start;padding:14px 16px;border:none;background:var(--surface,#fff);text-align:left;cursor:pointer;transition:background-color .15s;font-family:Inter,sans-serif}.ds-tile:hover{background:var(--background,#f8f9ff)}.ds-tile.is-on{background:color-mix(in srgb,var(--accent-soft-bg,#eef0fd) 75%,#fff);box-shadow:inset 0 0 0 1px var(--accent,#1f108e)}.ds-tile:focus-visible{outline:2px solid var(--accent,#1f108e);outline-offset:-3px}.ds-tile .l{font-size:12px;color:var(--muted,#64748b)}.ds-tile .v{margin-top:4px;font-size:22px;line-height:28px;font-weight:600;letter-spacing:-.02em;color:var(--foreground,#0b1c30);font-variant-numeric:tabular-nums}.ds-tile .c{margin-top:2px;font-size:12px;color:var(--muted,#64748b)}.ds-tile .c b{color:var(--ok,#067647)}.ds-tile .w{color:var(--warn,#b54708)}"
