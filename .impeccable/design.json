      "html": "<div class=\"ds-card\"><h3>Запас и поставки</h3><p>Машины в пути и товары ниже нормы</p></div>",
      "css": ".ds-card{background:var(--surface,#fff);border:1px solid var(--border,#e2e8f0);border-radius:8px;padding:16px 20px;transition:border-color .2s}.ds-card:hover{border-color:color-mix(in srgb,var(--accent,#1f108e) 35%,var(--border,#e2e8f0))}.ds-card h3{margin:0;font:600 15px Manrope,Inter,sans-serif;letter-spacing:-.01em;color:var(--foreground,#0b1c30)}.ds-card p{margin:2px 0 0;font:12.5px Inter,sans-serif;color:var(--muted,#64748b)}"
