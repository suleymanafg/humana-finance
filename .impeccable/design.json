  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main action: indigo, 4px corners, 36px.",
      "html": "<button class=\"ds-btn-primary\">Сохранить</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;height:36px;padding:0 14px;border:none;border-radius:4px;background:var(--accent,#1f108e);color:#fff;font:500 13px Inter,system-ui,sans-serif;transition:background-color .15s}.ds-btn-primary:hover{background:var(--accent-hover,#3730a3)}.ds-btn-primary:focus-visible{outline:2px solid var(--accent,#1f108e);outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Secondary action: white with hairline.",
      "html": "<button class=\"ds-btn-secondary\">Отмена</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;height:36px;padding:0 14px;border:1px solid var(--border,#e2e8f0);border-radius:4px;background:var(--surface,#fff);color:var(--foreground,#0b1c30);font:500 13px Inter,system-ui,sans-serif;transition:background-color .15s}.ds-btn-secondary:hover{background:var(--surface-low,#eff4ff)}.ds-btn-secondary:focus-visible{outline:2px solid var(--accent,#1f108e);outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Tertiary action: muted text, tint on hover.",
      "html": "<button class=\"ds-btn-ghost\">Подробнее</button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;height:36px;padding:0 14px;border:none;border-radius:4px;background:transparent;color:var(--muted,#64748b);font:500 13px Inter,system-ui,sans-serif;transition:background-color .15s,color .15s}.ds-btn-ghost:hover{background:var(--surface-low,#eff4ff);color:var(--foreground,#0b1c30)}.ds-btn-ghost:focus-visible{outline:2px solid var(--accent,#1f108e);outline-offset:2px}"
    },
    {
      "name": "Input",
      "kind": "input",
      "refersTo": "input",
      "description": "32px field, 8px corners, indigo border + mist ring on focus.",
      "html": "<input class=\"ds-input\" placeholder=\"1,000,000\" />",
      "css": ".ds-input{height:32px;padding:0 10px;border:1px solid var(--border,#e2e8f0);border-radius:8px;background:var(--surface,#fff);color:var(--foreground,#0b1c30);font:13px Inter,system-ui,sans-serif;box-shadow:0 1px 2px rgba(16,24,40,.04);outline:none;transition:box-shadow .15s}.ds-input:focus{border-color:var(--accent,#1f108e);box-shadow:0 0 0 3px var(--accent-soft,#e2dfff)}"
    },
    {
      "name": "Segmented Control",
      "kind": "chip",
      "refersTo": "segmented-active",
      "description": "View, measure and split choices; active option filled indigo.",
      "html": "<div class=\"ds-seg\"><button class=\"is-on\">Продажи</button><button>Штуки</button><button>Запас</button></div>",
      "css": ".ds-seg{display:inline-flex;padding:2px;border:1px solid var(--border,#e2e8f0);border-radius:6px;background:var(--surface,#fff)}.ds-seg button{border:none;background:transparent;border-radius:4px;padding:4px 12px;font:12.5px Inter,system-ui,sans-serif;color:var(--muted,#64748b);cursor:pointer;transition:color .15s}.ds-seg button:hover{color:var(--foreground,#0b1c30)}.ds-seg button.is-on{background:var(--accent,#1f108e);color:#fff}.ds-seg button:focus-visible{outline:2px solid var(--accent,#1f108e);outline-offset:2px}"
    },
    {
      "name": "Badge",
      "kind": "chip",
      "refersTo": "badge-warn",
      "description": "Status pill; tones neutral, ok, warn, accent, danger.",
      "html": "<span class=\"ds-badge ds-badge-ok\">Закрыт</span> <span class=\"ds-badge ds-badge-warn\">Частично</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;border-radius:9999px;padding:1px 8px;font:500 11px/20px Inter,system-ui,sans-serif}.ds-badge-ok{background:var(--ok-soft,#ecfdf3);color:var(--ok,#067647);border:1px solid rgba(6,118,71,.15)}.ds-badge-warn{background:var(--warn-soft,#fffaeb);color:var(--warn,#b54708);border:1px solid rgba(181,71,8,.15)}"
